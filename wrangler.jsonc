// Cloudflare Workers 배포 설정
// - dist 폴더(npm run build 결과)를 정적 파일로 올린다
// - /api/* 만 worker/index.ts 가 받는다: 로그인 · 책 · 세계관 · 열람실 (Durable Object + SQLite, 무료 플랜 가능)
{
  "name": "book",
  "compatibility_date": "2026-09-26",
  "main": "worker/index.ts",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // AI (worker/ai.ts): Gemini 키(비밀값)가 있으면 Gemini 먼저, 안 되면 Workers AI
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "LIBRARY", "class_name": "Library" },
      // Gemini 요청 중계 (미국 서부, worker/relay.ts) — life 앱과 같은 방식
      { "name": "RELAY", "class_name": "Relay" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Library"] },
    { "tag": "v2", "new_sqlite_classes": ["Relay"] }
  ]
}
